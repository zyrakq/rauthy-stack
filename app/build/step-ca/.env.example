# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=rauthy

IMAGE=ghcr.io/sebadob/rauthy:0.36.2

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true
# === STEP CA CONFIGURATION ===
# Nginx proxy configuration
VIRTUAL_PORT=8443
VIRTUAL_HOST=rauthy.local
VIRTUAL_PROTO=https

# Step CA SSL configuration
LETSENCRYPT_HOST=rauthy.local
LETSENCRYPT_EMAIL=john.smith@mail.com

KANIDM_TLS_CHAIN=/certs/${VIRTUAL_HOST}/fullchain.pem
KANIDM_TLS_KEY=/certs/${VIRTUAL_HOST}/key.pem